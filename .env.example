# Required: Zitadel instance configuration
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_SERVICE_ACCOUNT_USER_ID=
ZITADEL_SERVICE_ACCOUNT_KEY_ID=
# RSA private key — the "key" field of the downloaded service-user JSON key. Accepts any of:
# raw PEM, single-line PEM with escaped "\n", or base64-encoded PEM.
ZITADEL_SERVICE_ACCOUNT_PRIVATE_KEY=
ZITADEL_ORG_ID=

# Optional: Default project for role/grant operations
ZITADEL_PROJECT_ID=

# Optional: App-portal database (enables portal_* tools)
PORTAL_DATABASE_URL=

# Optional: Enable the login-policy WRITE tool (zitadel_set_self_registration).
# Off by default — toggling self-registration opens the org to public signup
# org-wide and leaves no object behind to audit. Set to "true" only when you
# intend an agent session to be able to change it.
ZITADEL_ENABLE_LOGIN_POLICY_WRITE=false

# Optional: Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
